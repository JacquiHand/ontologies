@prefix cc:        <http://creativecommons.org/ns#> .

<http://www.openlinksw.com/ontology/quotations#>
  a owl:Ontology ;
  rdfs:label """OpenLink Quotations Ontology"""^^xsd:string ;
  rdfs:comment """Ontology that defines entity and relation types used to describe quotations. Examples include
  the involved items and offers etc."""@en ;
  wdrs:describedby <http://www.openlinksw.com/ontology/quotations> ;
  dcterms:created "2014-05-18T13:00:00-05:00"^^xsd:dateTime ;
  schema:creator <http://www.openlinksw.com/#this> ;
  dcterms:modified "2015-03-20T13:38:00-05:00"^^xsd:dateTime ;
  owl:versionInfo "1.1.0"^^xsd:string ;
  owl:imports <http://purl.org/goodrelations/v1> ,
              <http://www.w3.org/2002/07/owl#> ,
              <http://www.w3.org/1999/02/22-rdf-syntax-ns#> ,
              <http://purl.org/dc/terms/> ;
  owl:imports <http://www.w3.org/2006/vcard/> ;
  <http://open.vocab.org/terms/defines> oplquo:Quotation ,
                                        oplquo:CustomerQuotation ,
                                        oplquo:ThirdPartyQuotation ,
                                        oplquo:QuotationItem ,
                                        oplquo:contains ,
                                        oplquo:hasOffering ,
                                        oplquo:quotationDate ,
                                        oplquo:madeQuotation ,
                                        oplquo:quotationNumber ,
                                        oplquo:customerPurchaseId ,
                                        oplquo:hasQuotationFile ,
                                        oplquo:quantity ,
                                        oplquo:quotationExpirationDate ,
                                        oplquo:basedOnPurchase ,
                                        oplquo:purchasedAs ,
                                        oplquo:hasAccountManager ,
                                        oplquo:usedShippingAgent ,
                                        oplquo:usedBillingAddress ,
                                        oplquo:usedCustomergAgent ;
  schema:about oplquo:Quotation ,
                                        oplquo:CustomerQuotation ,
                                        oplquo:ThirdPartyQuotation ,
                                        oplquo:QuotationItem ,
                                        oplquo:contains ,
                                        oplquo:hasOffering ,
                                        oplquo:quotationDate ,
                                        oplquo:madeQuotation ,
                                        oplquo:quotationNumber ,
                                        oplquo:customerPurchaseId ,
                                        oplquo:hasQuotationFile ,
                                        oplquo:quantity ,
                                        oplquo:quotationExpirationDate ,
                                        oplquo:basedOnPurchase ,
                                        oplquo:purchasedAs ,
                                        oplquo:hasAccountManager ,
                                        oplquo:usedShippingAgent ,
                                        oplquo:usedBillingAddress ,
                                        oplquo:usedCustomergAgent .


