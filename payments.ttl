<http://www.openlinksw.com/ontology/payments#> a owl:Ontology ;
  rdfs:label """OpenLink Payment Processors Ontology"""^^xsd:string ;
  rdfs:comment """Ontology that defines entity and relation types used to describe payments. Examples include process services,
  uri templates, uri parameters etc."""@en ;
  wdrs:describedby <http://www.openlinksw.com/ontology/payments> ;
  dcterms:created "2014-05-18T13:00:00-05:00"^^xsd:dateTime ;
  schema:creator <http://www.openlinksw.com/#this> ;
  dcterms:modified "2015-03-20T13:38:00-05:00"^^xsd:dateTime ;
  owl:versionInfo "1.0.0"^^xsd:string ;
  owl:imports <http://purl.org/goodrelations/v1>,
              <http://www.openlinksw.com/ontology/purchases#> ,
              <http://www.w3.org/2002/07/owl#> ,
              <http://www.w3.org/1999/02/22-rdf-syntax-ns#> ,
              <http://purl.org/dc/terms/> ,
              <http://www.openlinksw.com/ontology/webservices#> ;
  <http://open.vocab.org/terms/defines>
              oplpay:ProcessService ,
              oplpay:isProcessServiceOf ,
              oplpay:hasProcessService ,
              oplpay:uriTemplate ,
              oplpay:uriParameter ,
              oplpay:uriQueryParameterName ,
              oplpay:exampleValue ,
              oplpay:endpointURLString ,
              oplpay:endpointURL ;
  schema:about
              oplpay:ProcessService ,
              oplpay:isProcessServiceOf ,
              oplpay:hasProcessService ,
              oplpay:uriTemplate ,
              oplpay:uriParameter ,
              oplpay:uriQueryParameterName ,
              oplpay:exampleValue ,
              oplpay:endpointURLString ,
              oplpay:endpointURL .

