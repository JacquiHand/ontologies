# <-------------- ProcessService Endpoints--------------> #

# <-------------- ProcessService Endpoints Classes --------------> #

# changed owl:Class to oplwebsrv:WebService
oplpay:ProcessService
      a oplwebsrv:WebService ;
      rdfs:label "Process (Payment) Service Endpoint"^^xsd:string ;
      rdfs:subClassOf <http://rdfs.org/sioc/services#Service> , oplwebsrv:WebService ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/payments#> .

# <-------------- ProcessService Endpoints Properties --------------> #

# changed oplpay:ProcessService to oplwebsrv:WebService
oplpay:isProcessServiceOf
      a owl:ObjectProperty, rdf:Property ;
      rdfs:label "isProcessServiceOf"^^xsd:string ;
      skos:altLabel "Is Process Service Of"^^xsd:string ;
      rdfs:comment """This is the predicate/property that associates an instance of paid item with a Web Service."""@en ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/payments#> ;
      rdfs:subClassOf oplwebsrv:isWebServiceOf ;
      rdfs:domain oplwebsrv:WebService ;
      rdfs:range oplprchs:Purchase .

# changed oplpay:ProcessService to oplwebsrv:WebService
oplpay:hasProcessService
      a owl:ObjectProperty, rdf:Property ;
      rdfs:label "hasProcessService"^^xsd:string ;
      skos:altLabel "process service"^^xsd:string ;
      rdfs:comment """This is the predicate/property that associates an OpenLink Process Service with an instance of purchased item."""@en ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/licenses#> ;
      rdfs:domain oplprchs:Purchase ;
      rdfs:range oplwebsrv:WebService ;
      rdfs:subPropertyOf oplwebsrv:hasWebService, siocs:has_service .

# changed oplpay:ProcessService to oplwebsrv:WebService
oplpay:uriTemplate a owl:DatatypeProperty, rdf:Property ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/payments#> ;
      rdfs:label "paymentsUriTemplate"^^xsd:string ;
      rdfs:subPropertyOf oplwebsrv:uriTemplate ;
      skos:altLabel "Process (Payment) Service URI Template"^^xsd:string ;
      rdfs:domain oplwebsrv:WebService ;
      rdfs:range xsd:string .

# changed oplpay:ProcessService to oplwebsrv:WebService
oplpay:uriParameter a owl:DatatypeProperty, rdf:Property ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/payments#> ;
      rdfs:label "paymentsUriParameter"^^xsd:string ;
      #rdfs:subPropertyOf oplwebsrv:uriQueryParameterValue ;
      skos:altLabel "Process (Payment) Service URI Variable"^^xsd:string ;
      rdfs:domain oplwebsrv:WebService ;
      rdfs:range xsd:string .

# changed oplpay:ProcessService to oplwebsrv:WebService
oplpay:uriQueryParameterName a owl:DatatypeProperty, rdf:Property ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/payments#> ;
      rdfs:label "paymentsUriQueryParameterName"^^xsd:string ;
      rdfs:subPropertyOf oplwebsrv:uriQueryParameterName ;
      skos:altLabel "Process (Payment) Service URI Variable Name"^^xsd:string ;
      rdfs:domain oplwebsrv:WebService ;
      rdfs:range xsd:string .

# changed oplpay:ProcessService to oplwebsrv:WebService
oplpay:exampleValue a owl:DatatypeProperty, rdf:Property ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/payments#> ;
      rdfs:label "paymentsExampleValue"^^xsd:string ;
      rdfs:subPropertyOf oplwebsrv:exampleValue ;
      skos:altLabel "Process (Payment) Service Example Value"^^xsd:string ;
      rdfs:domain oplwebsrv:WebService ;
      rdfs:range xsd:string .

# changed oplpay:ProcessService to oplwebsrv:WebService
oplpay:endpointURLString a owl:DatatypeProperty, rdf:Property ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/payments#> ;
      rdfs:label "paymentsEndpointURLString"^^xsd:string ;
      rdfs:subPropertyOf oplwebsrv:endpointURLString ;
      skos:altLabel "Process (Payment) Service Endpoint URL String"^^xsd:string ;
      rdfs:domain oplwebsrv:WebService ;
      rdfs:range xsd:string .

# changed oplpay:ProcessService to oplwebsrv:WebService
oplpay:endpointURL a owl:DatatypeProperty, rdf:Property ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/payments#> ;
      rdfs:label "paymentsEndpointURL"^^xsd:string ;
      skos:altLabel "Process (Payment) Service Endpoint URL"^^xsd:string ;
      rdfs:domain oplwebsrv:WebService ;
      rdfs:subPropertyOf oplwebsrv:endpointURL ;
      rdfs:range xsd:string .


xhv:related owl:equivalentProperty rdfs:seeAlso .

foaf:primaryTopic owl:inverseOf xhv:describedby , wdrs:describedby .

wdrs:describedby owl:equivalentProperty xhv:describedby .

rdfs:subClassOf a owl:TransitiveProperty .


