@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gr:   <http://purl.org/goodrelations/v1#> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix os:   <http://www.openlinksw.com/schemas/shop#> .

os:ShopCart 
a rdfs:Class ;
rdfs:label "Shop Cart" ;
rdfs:comment "The definition of a shop cart entity type (Class)" ;
rdfs:subClassOf sioc:Container .

os:ShopCartItem 
a rdfs:Class ;
rdfs:label "Shop Cart Item" ;
rdfs:comment "The definition of a Shop Cart Item entity type (Class) " .
rdfs:subClassOf sioc:Item ;
owl:equivalentClass gr:Offering .

# os:offer a rdfs:Property ;
os:contains 
a rdfs:Property ;
rdfs:label "contains" ;
rdfs:comment "Associates a ShopCart entity with one or more ShopCartItems ." ;
rdfs:domain os:ShopCart ;
rdfs:range os:ShopCartItem ;
owl:equivalentProperty sioc:container_of .

os:quantity a rdfs:Property ;
rdfs:label "quantity" ;
rdfs:comment "The quantity of ShopCartItems for a given ShopCart instance" ;
rdfs:domain os:ShopCartItem ;
rdfs:range xsd:integer .
