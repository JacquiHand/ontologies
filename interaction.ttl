# <-------------- Classes --------------> #

inter:MachineAgent a owl:Class ;
      rdfs:subClassOf foaf:Agent ;
      owl:disjointWith foaf:Person, foaf:Organiztion ;
      rdfs:label "MachineAgent" ;
      rdfs:comment """A Machine or Piece of Software capable of autonomous operation."""@en ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/interaction#> .

inter:InteractionPayload a owl:Class ;
      rdfs:label "Interaction Payload" ;
      rdfs:comment """Entity type that represents an interaction payload (e.g., HTTP response or request) exchanged between user agents e.g., HTTP client or server."""@en ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/interaction#> .

# <-------------- Properties --------------> #

inter:fromMachine
      a rdf:Property, owl:ObjectProperty ;
      rdfs:label "fromMachine" ;
      rdfs:comment """Relation that associates an interaction payload (e.g., HTTP request or response) with the machine it originates from."""@en ;
      rdfs:domain inter:InteractionPayload ;
      rdfs:range  inter:MachineAgent ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/interaction#> .

inter:onBehalfOf
      a rdf:Property, owl:ObjectProperty ;
      rdfs:label "onBehalfOf" ;
      skos:altLabel "CNAME" ;
      rdfs:comment """Relation that associates an interaction payload (e.g., HTTP request or response) with its actual creator (a foaf:Agent denoted by a WebID) i.e., the person, organization, or machine that's controlling the user agent (e.g., HTTP client or server sofrware) in question"""@en ;
      schema:domainIncludes
          inter:InteractionPayload ,
          ecrm:Order ;
      rdfs:range  foaf:Agent ;
      rdfs:isDefinedBy <http://www.openlinksw.com/ontology/interaction#> .

inter:InteractionPayload owl:disjointWith ecrm:Order .