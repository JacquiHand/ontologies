xhv:related owl:equivalentProperty rdfs:seeAlso .

foaf:primaryTopic owl:inverseOf xhv:describedby , wdrs:describedby .

wdrs:describedby owl:equivalentProperty xhv:describedby .

rdfs:subClassOf a owl:TransitiveProperty .

<http://www.openlinksw.com/ontology/interaction#> a owl:Ontology ;
  rdfs:label """OpenLink Interactions Ontology"""^^xsd:string ;
  rdfs:comment """Ontology that defines entity and relation types used to describe interactions.
  Examples include agents, paylods etc."""@en ;
  wdrs:describedby <http://www.openlinksw.com/ontology/interaction> ;
  dcterms:created "2014-05-18T13:00:00-05:00"^^xsd:dateTime ;
  dcterms:modified "2015-03-20T13:38:00-05:00"^^xsd:dateTime ;
  schema:creator <http://www.openlinksw.com/#this> ;
  owl:versionInfo "1.0.0"^^xsd:string ;
  owl:imports <http://purl.org/goodrelations/v1> ,
              <http://www.w3.org/2002/07/owl#> ,
              <http://www.w3.org/1999/02/22-rdf-syntax-ns#> ,
              <http://purl.org/dc/terms/> ,
              <http://www.openlinksw.com/ontology/ecrm#> ;
  <http://open.vocab.org/terms/defines>
              inter:MachineAgent ,
              inter:InteractionPayload ,
              inter:fromMachine ,
              inter:onBehalfOf ;
  schema:about
              inter:MachineAgent ,
              inter:InteractionPayload ,
              inter:fromMachine ,
              inter:onBehalfOf .

<http://open.vocab.org/terms/defines> owl:inverseOf <http://www.w3.org/2007/05/powder-s#describedby> .

