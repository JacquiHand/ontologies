# <-------------- ODBC Ontology --------------> #

# <-------------- ODBC Ontology Classes --------------> #

odbc:DistributedTransactionMonitor a owl:Class ;
   rdfs:label "Distributed Transaction Monitor"@en ;
   rdfs:comment """
					Technology for managing Atomicity, Consistency, Isolation, and Durability of transactions
					across machine boundaries, on a distributed network. 
   				"""@en ;
   skos:altLabel "ODBC Driver"@en  ;
   is schema:about of <http://docs.oracle.com/cd/B10501_01/appdev.920/a96590/adga1_xa.htm>, <https://technet.microsoft.com/en-us/library/cc754954(v=ws.10).aspx>,
   	 				  <http://en.wikipedia.org/wiki/Tuxedo_(software)> ;
   is rdfs:range of odbc:hasDistributedTransactionMonitorSupport ;
   rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .
   
odbc:ScrollableCursor a owl:Class ;
  rdfs:label "Scrollable Cursor"@en ;
  rdfs:comment """
				Data paging and scrolling [sliding window] mechanism with varying levels of change sensitivity in regards to  
				query resultset [solution] row membership, order, and values.  
  				"""@en ;
  skos:altLabel "ODBC Driver"@en  ;
  is schema:about of <https://msdn.microsoft.com/en-us/library/ms710292(v=vs.85).aspx> ;
  is rdfs:range of odbc:hasCursorSupport ;
  rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .
	     
odbc:StaticScrollableCursor a owl:Class ;
   rdfs:subClassOf odbc:ScrollableCursor ;
   rdfs:label "Static Scrollable Cursor"@en ;
   rdfs:comment """
					Data paging and scrolling [sliding window] mechanism that's insensitive to changes (membership, order, and values) that occur 
					to a query resultset (solution) after it has been created. 
   				"""@en ;
   skos:altLabel "ODBC Driver"@en  ;
   is schema:about of <https://msdn.microsoft.com/en-us/library/ms710267(v=vs.85).aspx> ;
   is rdfs:range of odbc:hasScrollableCursorTypeSupport ;
   is rdfs:domain of odbc:isChangeSenstive ;
   rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .
   

odbc:DynamicScrollableCursor a owl:Class ;
  rdfs:subClassOf odbc:ScrollableCursor ;
  rdfs:label "Dynamic Scrollable Cursor"@en ;
  rdfs:comment """
  					Data paging and scrolling [sliding window]mechanism that's sensitive to changes (membership, order, and values) that occur 
					to a query resultset (solution) after it has been created. This behaviour is achieved by creating
					keysets afresh [from tables used to drive a query resultset or solution] prior to each scroll (paging) operation.
  				"""@en ;
  skos:altLabel "ODBC Driver"@en  ;
  is schema:about of <https://msdn.microsoft.com/en-us/library/ms715420(v=vs.85).aspx> ;
  is rdfs:range of odbc:hasScrollableCursorTypeSupport ;
  is rdfs:domain of odbc:isFullyChangeSenstive, odbc:isDynamicKeySetDriven ;
    rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .

odbc:KeySetScrollableCursor a owl:Class ;
rdfs:subClassOf odbc:ScrollableCursor ;
rdfs:label "Keyset Driven Scrollable Cursor"@en ;
rdfs:comment """
				Data paging and scrolling [sliding window] mechanism that's sensitive to row value changes while being partially sensitive to 
				changes in membership and order, once opened. This behaviour is the result of keysets being created
				from primary keys of tables used to derive a query resultset (solution). 
			"""@en ;
skos:altLabel "ODBC Driver"@en  ;
is schema:about of <https://msdn.microsoft.com/en-us/library/ms709273(v=vs.85).aspx> ;
is rdfs:range of odbc:hasScrollableCursorTypeSupport ;
is rdfs:domain of odbc:isFullyChangeSenstive, odbc:isKeySetDriven ;
rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#> .


odbc:MixedScrollableCursor a owl:Class ;
rdfs:subClassOf odbc:ScrollableCursor ;
rdfs:label "Mixed Scrollable Cursor"@en ;
rdfs:comment """
				Data paging and scrolling [sliding window] mechanism that's partially sensitive to row value changes while also being partially sensitive to 
				changes in membership and order, once opened. This behaviour is the result of keysets [with fixed sizes] being created
				from primary keys of tables used to derive a query resultset (solution). 
			"""@en ;
is schema:about of <https://msdn.microsoft.com/en-us/library/ms713864(v=vs.85).aspx> ;
is rdfs:range of odbc:hasScrollableCursorTypeSupport ;
is rdfs:domain of odbc:isFullyChangeSenstive, odbc:isKeySetDriven, odbc:isDynamicKeySetDriven ;
rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#> .

	
odbc:OpenDatabaseConnectivityDriver  a owl:Class ;
   rdfs:subClassOf oplsof:DataAccessProtocol ;
   rdfs:label "Open Database Connectivity Driver"@en ;
   skos:altLabel "ODBC Driver"@en  ;
   is rdfs:domain of odbc:isOpsysArchitectureCompliant, odbc:isUsableWith, odbc:hasOSAvailability,
				  odbc:hasDBMSReleaseSupport, odbc:isODBCLevelCompliant,
				  odbc:hasScrollableCursorTypeSupport, odbc:hasDistributedTransactionMonitorSupport,
				  odbc:hasMultipleActiveStatementsSupport, odbc:hasDataTransmissionEncryptionSupport,
				  odbc:hasFineGrainedAccessControls, odbc:hasDatabaseNetworkConnectivityMethod ;
   rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .

oplsof:DatabaseNetworkConnectivityMethod a owl:Class ;
   rdfs:subClassOf <http://sw.opencyc.org/concept/Mx4rvWMjUJwpEbGdrcN5Y29ycA> ;
   rdfs:label "Database Network Connectivity Method"@en ;
   rdfs:comment """
				How a driver connects to a DBMS over a network.
		 """@en ;
   is    rdfs:range of odbc:hasDatabaseNetworkConnectivityMethod ;
   is rdfs:domain of oplsof:NetworkTransportProtocol  ;
   rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .

odbc:DBVendorNativeNetworkConnectivity a owl:Class ;
   rdfs:subClassOf <http://sw.opencyc.org/concept/Mx4rvWMjUJwpEbGdrcN5Y29ycA>, oplsof:DatabaseNetworkConnectivityMethod ;
   rdfs:label "DBVendorNativeNetworkConnectivity"@en  ;
   skos:altLabel "Database Vendor Provided Native Network Connectivity"@en ;
   rdfs:comment """
			In this form of DBMS connectivity, a driver leverages built-in network connectivity to a DBMS using
			a library provided by the target DBMS vendor, that's pre-installed as part of the DBMS product packaging.
			It has the advantage of providing a convenient installation and configuration experience to driver users.
			It has the disadvantage of delivering unpredictable experience and sophistication in areas such as cost-effective
			administration, privacy, security, and fine-grained access controls.
		"""@en ;
   rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .

odbc:DBVendorProvidedNetworkConnectivity a owl:Class ;
   rdfs:subClassOf <http://sw.opencyc.org/concept/Mx4rvWMjUJwpEbGdrcN5Y29ycA>, oplsof:DatabaseNetworkConnectivityMethod ;
   rdfs:label "DBVendorProvidedNetworkConnectivity"@en  ;
   skos:altLabel "Database Vendor Provided Network Client Connectivity"@en  ;
   rdfs:comment """
			In this form of DBMS connectivity, a driver depends on client networking services provided the vendor of
			a DBMS targeted by a driver. It has the disadvantage of introducing preinstallation and configuration
			as driver usage prequisites. It has the advantage of providing a high-performance networking layer [in many cases]
			that's fine-tuned for its target DBMS.
		"""@en  ;
   rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .


odbc:DBVendorIndependentNetworkConnectivity a owl:Class ;
   rdfs:subClassOf <http://sw.opencyc.org/concept/Mx4rvWMjUJwpEbGdrcN5Y29ycA>, oplsof:DatabaseNetworkConnectivityMethod ;
   rdfs:label "DBVendorIndependentNetworkConnectivity"@en  ;
   skos:altLabel "Database Vendor Independent Network Connectivity"@en  ;
   rdfs:comment """
			In this form of DBMS connectivity, a driver uses its own networking functionality to connect to a
			3rd party DBMS. It has the advantage of providing innovations [as part of the driver] in critical
			areas such as privacy,security, and cost-effective adminsitration.
		"""@en  ;
   rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .


