   skos:altLabel "MS Access"@en  ;
   skos:prefLabel "Access"@en  ;
   rdfs:seeAlso dbpedia:Microsoft_Access ;
   rdfs:isDefinedBy <http://www.openlinksw.com/ontology/odbc#>, <> .

odbc:MSExcel a oplsof:ApplicationProgram ;
   rdfs:label "Microsoft Excel"@en  ;
   skos:altLabel "Excel"@en  ;
